# The agent connects to the target as two least-privilege roles (created by `dbremedy setup`).
DBR_TARGET_OBSERVER_DSN=postgresql://dbr_observer:CHANGE-ME@db.internal:5432/shop
DBR_TARGET_OPERATOR_DSN=postgresql://dbr_operator:CHANGE-ME@db.internal:5432/shop

# Where incidents, the action ledger and checkpoints live: memory, sqlite or postgres.
DBR_STORE=sqlite
DBR_SQLITE_PATH=/data/dbremedy.db
# DBR_STORE=postgres
# DBR_STORE_DSN=postgresql://dbremedy:CHANGE-ME@ops-db.internal:5432/dbremedy

# Alertmanager authenticates to the webhook with this bearer token.
DBR_WEBHOOK_TOKEN=CHANGE-ME
# When set, only callers presenting X-Service-Token can assert X-User-Id / X-User-Roles.
DBR_SERVICE_TOKEN=

# rule (default) or llm, through any OpenAI-compatible endpoint.
DBR_PLANNER=rule
# DBR_LLM_BASE_URL=https://api.example.com/v1
# DBR_LLM_MODEL=
# DBR_LLM_API_KEY=

# Every action needs approval while this is on (in addition to the policy's freeze windows).
DBR_CHANGE_FREEZE=false
# Record what would be done and do nothing.
DBR_DRY_RUN=false

# Optional: your own runbooks, policy, or parameter overrides per runbook.
# DBR_RUNBOOKS=/etc/dbremedy/runbooks
# DBR_POLICY=/etc/dbremedy/policy.yaml
# DBR_RUNBOOK_OVERRIDES=/etc/dbremedy/overrides.yaml
DBR_LOG_LEVEL=INFO

# Only for `dbremedy setup`, `chaos`, `eval` and `demo`.
# DBR_ADMIN_DSN=postgresql://postgres:CHANGE-ME@localhost:5432/shop
# DBR_APP_DSN=postgresql://dbr_app:dbr-app-local@localhost:5432/shop
